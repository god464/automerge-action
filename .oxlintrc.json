{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["vitest", "import", "node", "promise", "unicorn", "typescript", "oxc"],
  "categories": { "correctness": "error" },
  "options": { "typeAware": true, "typeCheck": true },
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-param-reassign": ["error", { "props": true }],
    "no-plusplus": "error",
    "no-else-return": "error",
    "no-shadow": "error",
    "no-unused-vars": "error",
    "no-use-before-define": ["error", { "functions": false }],
    "import/no-cycle": "error",
    "import/no-mutable-exports": "error",
    "unicorn/no-process-exit": "error",
    "unicorn/no-this-assignment": "error",
    "unicorn/no-static-only-class": "error",
    "typescript/no-explicit-any": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "error",
    "max-depth": ["error", 2],
    "max-params": ["error", 3],
    "max-lines-per-function": ["error", { "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", 10]
  },
  "overrides": [
    {
      "files": ["src/domain/**", "src/events/**"],
      "rules": { "typescript/prefer-readonly-parameter-types": "error" }
    },
    {
      "files": ["src/github/**", "src/git/**", "src/main.ts", "test/**", "src/run/**"],
      "rules": {
        "complexity": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "typescript/prefer-readonly-parameter-types": "off"
      }
    },
    { "files": ["src/result.ts"], "rules": { "max-params": "off" } }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
