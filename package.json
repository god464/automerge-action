{
  "name": "automerge-action",
  "version": "0.16.5",
  "private": true,
  "description": "GitHub action to automatically merge pull requests",
  "license": "MIT",
  "author": "Pascal",
  "type": "module",
  "scripts": {
    "it": "tsx it/it.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "compile": "tsc -p tsconfig.build.json && ncc build build/bin/automerge.js --license LICENSE -o dist",
    "prepack": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run compile"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/rest": "^22.0.1",
    "argparse": "^3.0.2",
    "object-resolve-path": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vercel/ncc": "^0.45.0",
    "dotenv": "^18.0.8",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
